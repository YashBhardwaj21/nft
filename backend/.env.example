PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=          # mongodb+srv://user:pass@cluster.mongodb.net/dbname

# JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=           # min 64 random chars
JWT_EXPIRE=24h
ADMIN_SECRET=         # node -e "require('crypto').randomBytes(32).toString('hex')"

# IPFS (Pinata)
PINATA_JWT=           # from https://app.pinata.cloud → API Keys

# ── Blockchain ────────────────────────────────────────────────────────────────
# For LOCAL development (Hardhat node)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONFIRMATIONS_N=1
REORG_GUARD=false

# For SEPOLIA testnet (comment above, uncomment below)
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# CHAIN_ID=11155111
# CONFIRMATIONS_N=6
# REORG_GUARD=true

# For MAINNET (comment above, uncomment below)
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# CHAIN_ID=1
# CONFIRMATIONS_N=12
# REORG_GUARD=true

# Contract Addresses — auto-set by scripts/deploy.ts, never edit manually
CONTRACT_ADDRESS=
MARKETPLACE_ADDRESS=

# App Limits
MAX_PAGE_SIZE=100

# Admin API secret — required to access /admin/* endpoints
ADMIN_SECRET=         # node -e "require('crypto').randomBytes(32).toString('hex')"

PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=
JWT_EXPIRE=30d

# ── IPFS (Pinata) ─────────────────────────────────────────────────────────────
# Get your JWT from: https://app.pinata.cloud → API Keys → New Key
PINATA_JWT=

# ── Blockchain ────────────────────────────────────────────────────────────────
# For LOCAL development (Hardhat node):
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONFIRMATIONS_N=1
REORG_GUARD=false

# For SEPOLIA testnet (comment above, uncomment below):
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# CHAIN_ID=11155111
# CONFIRMATIONS_N=6
# REORG_GUARD=true

# For MAINNET (comment above, uncomment below):
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# CHAIN_ID=1
# CONFIRMATIONS_N=12
# REORG_GUARD=true

# ── Contract Addresses ────────────────────────────────────────────────────────
# Auto-set by scripts/deploy.ts after each deployment — do not edit manually
CONTRACT_ADDRESS=
MARKETPLACE_ADDRESS=

# ── App Config ────────────────────────────────────────────────────────────────
MAX_PAGE_SIZE=100

# ── Admin API ─────────────────────────────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
ADMIN_SECRET=

# ── Chain Sync Tuning ─────────────────────────────────────────────────────────
BACKFILL_BATCH_SIZE=10
BACKFILL_MAX_RETRIES=3
REALTIME_POLL_INTERVAL_MS=30000

# ── API ───────────────────────────────────────────────────────────────────────
# /api for local dev | https://api.yourdomain.com for production
VITE_API_BASE_URL=/api

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Get your Project ID from: https://cloud.walletconnect.com
VITE_WALLET_CONNECT_PROJECT_ID=

# ── Contract Addresses ────────────────────────────────────────────────────────
# Auto-set by scripts/deploy.ts after each deployment — do not edit manually
VITE_CONTRACT_ADDRESS=
VITE_MARKETPLACE_ADDRESS=

# ── Network Configuration ─────────────────────────────────────────────────────
# For LOCAL development (Hardhat node):
VITE_SUPPORTED_CHAIN_ID=31337
VITE_SUPPORTED_CHAIN_HEX=0x7A69
VITE_NETWORK_NAME=localhost
VITE_SEPOLIA_RPC_URL=http://127.0.0.1:8545

# For SEPOLIA testnet (comment above, uncomment below):
# VITE_SUPPORTED_CHAIN_ID=11155111
# VITE_SUPPORTED_CHAIN_HEX=0xaa36a7
# VITE_NETWORK_NAME=sepolia
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# For MAINNET (comment above, uncomment below):
# VITE_SUPPORTED_CHAIN_ID=1
# VITE_SUPPORTED_CHAIN_HEX=0x1
# VITE_NETWORK_NAME=mainnet
# VITE_SEPOLIA_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
